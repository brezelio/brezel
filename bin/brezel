#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v bun >/dev/null 2>&1; then
  printf 'bun is required for bin/brezel but was not found in PATH.\n' >&2
  exit 1
fi

# Bun would load .env into process.env, and those startup values would override .env edits made during the run in Docker Compose.
exec bun --no-env-file run "$script_dir/brezel.ts" "$@"
