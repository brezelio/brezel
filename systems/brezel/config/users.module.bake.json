[
  {
    "resource_module": "users",
    "resource": {
      "identifier": "users",
      "type": "users",
      "icon": "user",
      "title": "name",
      "options": {
        "capabilities": [
          {
            "identifier": "OrganizationMembers",
            "options": {
              "unit_module": "departments",
              "profession_module": "professions",
              "active_values": ["active"],
              "field_mapping": {
                "name_field": "name",
                "unit_field": "department",
                "active_field": "status",
                "type_field": "actor_type"
              }
            }
          },
          {
            "identifier": "AgentProxyOwner",
            "options": {
              "auto_provision": true,
              "background_enabled": true,
              "skill_module": "skills"
            }
          }
        ]
      },
      "layouts": {
        "detail": "config/users.layout.detail"
      },
      "fields": [
        {
          "identifier": "name",
          "type": "text"
        },
        {
          "identifier": "avatar",
          "type": "file",
          "options": {
            "references": "files"
          }
        },
        {
          "identifier": "actor_type",
          "type": "choice",
          "options": {
            "values": ["human", "ai"],
            "default": "human",
            "mode": "buttons",
            "allow_clear": false
          }
        },
        {
          "identifier": "status",
          "type": "choice",
          "options": {
            "values": ["active", "inactive"],
            "default": "active",
            "allow_clear": false
          }
        },
        {
          "identifier": "email",
          "type": "email"
        },
        {
          "identifier": "password",
          "type": "password",
          "options": {
            "ignore_when_empty": true
          }
        },
        {
          "identifier": "roles",
          "type": "multiselect",
          "options": {
            "references": "roles"
          }
        }
      ]
    }
  }
]
