      "icon": "mdi:calendar-clock",
      "rows": [
        {
          "cols": [
            {
              "components": [
                {
                  "type": "widget",
                  "options": {
                    "widget": "schedule_profile",
                    "module": "agent_schedules",
                    "dynamic_height": true,
                    "show_in": [
                      "module.show"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "cols": [
            {
              "components": [
                {
                  "type": "headline",
                  "options": {
                    "identifier": "task",
                    "icon": "mdi:robot-outline",
                    "show_in": [
                      "module.edit",
                      "module.create"
                    ]
                  }
                },
                {
                  "type": "field_group",
                  "options": {
                    "fields": [
                      "name",
                      "agent_owner",
                      "enabled",
                      "objective",
                      "remember_runs",
                      "quiet_replies"
                    ],
                    "show_in": [
                      "module.edit",
                      "module.create"
                    ]
                  }
                }
              ]
            },
            {
              "components": [
                {
                  "type": "headline",
                  "options": {
                    "identifier": "timing",
                    "icon": "mdi:clock-outline",
                    "show_in": [
                      "module.edit",
                      "module.create"
                    ]
                  }
                },
                {
                  "type": "field_group",
                  "options": {
                    "fields": [
                      "schedule_preset",
                      "cron_expression",
                      "timezone"
                    ],
                    "show_in": [
                      "module.edit",
                      "module.create"
                    ]
                  }
                },
                {
                  "type": "headline",
                  "options": {
                    "identifier": "status",
                    "icon": "mdi:history",
                    "show_in": [
                      "module.edit",
                      "module.create"
                    ]
                  }
                },
                {
                  "type": "field_group",
                  "options": {
                    "fields": [
                      "next_run_at",
                      "last_dispatched_at",
                      "last_skipped_at",
                      "last_run_id",
                      "last_error"
                    ],
                    "show_in": [
                      "module.edit",
                      "module.create"
                    ]
                  }
                }
              ]
            }
          ]
        }
