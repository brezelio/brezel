{
  "identifier": "ReportAgentAnswer",
  "title": "Report agent answer",
  "async": false,
  "debug": false,
  "entry": "reportAgentAnswer",
  "events": [
    {
      "identifier": "reportAgentAnswer",
      "type": "webhook"
    }
  ],
  "elements": [
    {
      "name": "reportAgentAnswer",
      "type": "event/webhook",
      "options": {
        "allow_agent_trigger": false
      },
      "set": {
        "input": "input:"
      },
      "to": {
        "default": {
          "checkConsent": [
            "default"
          ]
        }
      },
      "meta": {
        "position": [
          0,
          0
        ]
      }
    },
    {
      "name": "checkConsent",
      "type": "flow/if",
      "options": {
        "condition": "$input.consent_version == 'agent-report-v1' && !empty(env('BREZEL_REPORT_API_KEY')) && !empty(env('BREZEL_REPORT_URL'))"
      },
      "to": {
        "default": {
          "collectDiagnostics": [
            "default"
          ]
        },
        "else": {
          "unavailable": [
            "default"
          ]
        }
      },
      "meta": {
        "position": [
          320,
          0
        ]
      }
    },
    {
      "name": "collectDiagnostics",
      "type": "op/recipe",
      "options": {
        "recipe": "agentDiagnostics.snapshot($input.message_id, $input.report_id, $input.comment ?? '')"
      },
      "set": {
        "package": "default:"
      },
      "to": {
        "default": {
          "sendReport": [
            "default"
          ]
        }
      },
      "meta": {
        "position": [
          640,
          0
        ]
      }
    },
    {
      "name": "sendReport",
      "type": "api/http",
      "options": {
        "uri": {
          ".recipe": "env('BREZEL_REPORT_URL')"
        },
        "method": "POST",
        "follow_redirects": false,
        "response_type": "json",
        "request": {
          "headers": "{'X-API-Key': env('BREZEL_REPORT_API_KEY'), 'Accept': 'application/json'}",
          "json": "{'input': $package}",
          "timeout": "30",
          "http_errors": "true"
        }
      },
      "to": {
        "default": {
          "respond": [
            "default"
          ]
        },
        "error": {
          "unavailable": [
            "default"
          ]
        }
      },
      "meta": {
        "position": [
          960,
          0
        ]
      }
    },
    {
      "name": "respond",
      "type": "action/response",
      "options": {
        "status": 200
      },
      "meta": {
        "position": [
          1280,
          0
        ]
      }
    },
    {
      "name": "unavailable",
      "type": "op/recipe",
      "options": {
        "recipe": "{'success': false, 'error': 'Report delivery unavailable.'}"
      },
      "to": {
        "default": {
          "respondError": [
            "default"
          ]
        }
      },
      "meta": {
        "position": [
          1280,
          220
        ]
      }
    },
    {
      "name": "respondError",
      "type": "action/response",
      "options": {
        "status": 502
      },
      "meta": {
        "position": [
          1600,
          220
        ]
      }
    }
  ]
}
