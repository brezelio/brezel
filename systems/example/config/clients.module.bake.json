[
  {
    "resource_module": "clients",
    "resource": {
      "identifier": "clients",
      "type": "clients",
      "icon": "mdi:office-building-cog",
      "title": "title",
      "layouts": {
        "detail": "config/clients.layout.detail"
      },
      "fields": [
        {
          "identifier": "title",
          "type": "text",
          "options": {
            "autofocus": true,
            "rules": "required"
          }
        },
        {
          "identifier": "color",
          "type": "color"
        },
        {
          "identifier": "mail_host",
          "type": "text"
        },
        {
          "identifier": "mail_port",
          "type": "number"
        },
        {
          "identifier": "mail_username",
          "type": "text"
        },
        {
          "identifier": "mail_password",
          "type": "password",
          "options": {
            "ignore_when_empty": true,
            "show_in_resource_table": false
          }
        },
        {
          "identifier": "mail_encryption",
          "type": "choice",
          "options": {
            "default": "tls",
            "values": [
              "tls",
              "ssl",
              "none"
            ]
          }
        },
        {
          "identifier": "mail_from_address",
          "type": "email"
        },
        {
          "identifier": "mail_from_name",
          "type": "text"
        }
      ]
    }
  }
]
